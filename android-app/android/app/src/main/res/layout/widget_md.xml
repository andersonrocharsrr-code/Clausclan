<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="8dp">

    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_launcher" android:contentDescription="@null" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Gasto no mês" android:textColor="#B3FFFFFF" android:textSize="11sp" android:maxLines="1" />
        <TextView android:id="@+id/w_amount" android:layout_width="match_parent" android:layout_height="26dp"
            android:text="R$ 0,00" android:textColor="#FFFFFF" android:textStyle="bold" android:maxLines="1" android:gravity="center_vertical"
            android:textSize="19sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="19sp" />
    </LinearLayout>

    <TextView android:id="@+id/w_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
        android:text="" android:textColor="#B3FFFFFF" android:textSize="12sp" android:visibility="gone" />

    <ImageView android:id="@+id/w_add" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="10dp"
        android:background="@drawable/widget_plus_bg" android:padding="11dp" android:src="@drawable/widget_plus" android:contentDescription="Novo gasto" />
</LinearLayout>
